# Copy to .env and fill in your values. Never commit .env.

# --- SMTP (163 default; change host for QQ/Gmail) ---
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=yourname@163.com
SMTP_AUTH_CODE=your_authorization_code

# --- Resume & message ---
RESUME_PATH=assets/resume.pdf
SUBJECT=应聘-姓名-目标岗位
BODY=您好，我是应届生姓名，附件是我的简历，恳请查阅。祝好！

# --- Send controls ---
SEND_INTERVAL=40
DAILY_LIMIT=25
